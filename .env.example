# Copy to .env and adjust once you confirm the real values with the team
# (see README "Questions for the team"). All of these are guesses documented
# as such — the point is that the test is configurable, not hard-coded.

QUIZ_BASE_URL=https://stage.allright.com
QUIZ_START_URL=https://stage.allright.com/uk/app/sign-up/long/charlie/age-range

# Matched against response URLs (method must be POST, status must be ok).
QUIZ_COMPLETION_NETWORK_PATTERN=/(sign-?up|registration|users|bookings?)\b

# Matched against page.url() after quiz completion.
QUIZ_COMPLETION_URL_PATTERN=/(welcome|thank-you|dashboard)\b

# data-testid of a generic "you're done" element, if one exists.
QUIZ_COMPLETION_TEST_ID=signup-success

# Comma-separated keys that must appear somewhere in the completion response
# body (searched recursively, not at the top level only).
QUIZ_REQUIRED_RESPONSE_KEYS=userId,lessonId
